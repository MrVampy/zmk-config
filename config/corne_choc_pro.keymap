#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>
#include <locale/keys_da.h>

// dk OS layout reinterprets US scancodes — most symbols on the SYMBOL layer
// don't produce what their ZMK macro names say. We use DA_* macros from the
// zmk-locales module (wired in via config/west.yml) so the keymap source
// matches what actually lands on screen.
//
// QWERTY Danish letters: DA_A_RING (å), DA_AE (æ), DA_O_SLASH (ø). These resolve
// to the same scancodes as LBKT/SEMI/SQT but the names self-document the intent.

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

/ {
    behaviors {
        // Mod-morph for the QWERTY hyphen-key (position 38, FSLH scancode).
        //
        //   tap          → DA_MINUS  → `-` on dk
        //   tap + Shift  → DA_QMARK  → `?` on dk
        //
        // Recovers the canonical "Shift+/ = ?" muscle memory from US/dk
        // physical keyboards, made to work on dk OS layout. Without this
        // morph, Shift+FSLH on dk produces `_` (underscore), which is the
        // dk default but not what most people reach for when wanting `?`.
        //
        // `_` is still accessible via DA_UNDER on SYMBOL layer position 34.
        hyp_qm: hyphen_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DA_MINUS>, <&kp DA_QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // SYMBOL+A — apostrophe / double-quote pair via the dk `' *` keysym
        // family. tap = ' (DA_APOS), shift = " (DA_DQT). Lives on the
        // left-pinky home row so SYMBOL (right thumb hold) + A (left pinky)
        // is a clean cross-hand chord. Mnemonic: A → Apostrophe.
        apos_dqt: apostrophe_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DA_APOS>, <&kp DA_DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Layer-tap with 100ms tapping-term, used on both layer-toggle thumb
        // keys (mo 1 / mo 2). Held alone for >100ms → layer activates. Chorded
        // with any other key (hold-preferred flavor) → layer activates
        // immediately so symbol/number layer chords feel snappy. Released
        // alone within 100ms → BSPC fires.
        //
        // 100ms is aggressive — most ergo setups use 175-225ms. The short
        // window means "hold" triggers easily (good for chord-heavy usage)
        // but "tap" requires deliberate, fast release. Tune up if accidental
        // layer activations happen on intended BSPC taps.
        lt_bspc: layer_tap_bspc_100ms {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <1>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            retro-tap;
            bindings = <&mo>, <&kp>;
        };
    };

    // ------------------------------------------------------------------------
    // Macros for Spanish ¡ and ¿. Standard dk(basic) (inherited by all dk
    // variants including winkeys) already has both:
    //   AltGr+1            → ¡  (latin(type2) AE01 level 3)
    //   AltGr+Shift+(+key) → ¿  (dk AE11 level 4: [plus, question, plusminus, questiondown])
    // So these macros just fire the canonical key combinations — no custom
    // xkb variant needed.
    // ------------------------------------------------------------------------
    macros {
        inv_excl: inverted_exclamation {
            label = "INV_EXCL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <
                &macro_press &kp RALT
                &macro_tap &kp N1
                &macro_release &kp RALT
            >;
        };

        inv_ques: inverted_question {
            label = "INV_QUES";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <
                &macro_press &kp RALT &kp LSHFT
                &macro_tap &kp MINUS
                &macro_release &kp LSHFT &kp RALT
            >;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |
            bindings = <
                &kp TAB   &kp Q &kp W &kp E &kp R &kp T &kp C_MUTE &kp C_PP &kp Y &kp U  &kp I     &kp O   &kp P     &kp DA_A_RING
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G &kp LALT   &kp ESC  &kp H &kp J  &kp K     &kp L   &kp DA_AE &kp DA_O_SLASH
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B                     &kp N &kp M  &kp COMMA &kp DOT &hyp_qm  &kp RSHFT
                                      &kp LGUI &lt_bspc 1 BSPC &kp SPACE              &kp RET &lt_bspc 2 BSPC &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        lower_layer {
            display-name = "NUMBER";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |
            bindings = <
                &trans    &kp N1       &kp N2          &kp N3       &kp N4       &kp N5       &trans    &trans    &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &none
                &trans    &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans    &trans    &none    &kp LEFT &kp DOWN &kp UP    &kp RIGHT &none
                &trans    &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock                   &none    &none    &none  &none     &none  &trans
                                                       &trans       &trans       &trans                           &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |
            bindings = <
                &trans    &kp DA_EXCL &kp DA_AT &kp DA_HASH &kp DA_DLLR &kp DA_PRCNT &trans    &trans    &kp DA_CARET &kp DA_AMPS  &kp DA_ASTRK &kp DA_LPAR &kp DA_RPAR &none
                &trans    &apos_dqt   &inv_excl &inv_ques   &kp DA_EURO &kp DA_POUND_SIGN &trans &trans &kp DA_EQUAL &kp DA_SLASH &kp DA_LBKT  &kp DA_RBKT &kp DA_BSLH &kp DA_GRAVE
                &trans    &kp DA_ACUTE &kp DA_TILDE &kp DA_UMLAUT &none  &none                            &kp DA_UNDER &kp DA_PLUS  &kp DA_LBRC  &kp DA_RBRC &kp DA_PIPE &trans
                                                &trans      &trans      &trans                           &trans       &trans       &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans       
            >;
        };
    };
};
