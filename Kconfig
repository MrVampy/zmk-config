menu "Corne custom features"

config CORNE_REACTIVE_RGB
    bool "Reactive per-key RGB lighting"
    default y
    select LED_STRIP
    select SPI
    select WS2812_STRIP
    select ZMK_EXT_POWER
    select ZMK_LOW_PRIORITY_WORK_QUEUE
    help
      Use the keyboard's RGB strip as a per-key reactive typing light instead
      of ZMK's stock whole-board underglow effects.

if CORNE_REACTIVE_RGB

config CORNE_REACTIVE_RGB_BRT_BATTERY
    int "Reactive RGB brightness on battery"
    default 20
    range 1 100

config CORNE_REACTIVE_RGB_BRT_USB
    int "Reactive RGB brightness on USB power"
    default 100
    range 1 100

endif

endmenu
