menu "Corne custom firmware"

config ZMK_CORNE_HOTPATHS
    bool "Corne typing hot-path overrides"
    default y if BOARD_CORNE_CHOC_PRO_LEFT
    depends on BOARD_CORNE_CHOC_PRO_LEFT && ZMK_SPLIT_ROLE_CENTRAL

